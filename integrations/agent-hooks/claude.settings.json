{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/prowl",
            "args": ["guard", "--protocol", "claude"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/prowl",
            "args": ["guard", "--protocol", "claude"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
